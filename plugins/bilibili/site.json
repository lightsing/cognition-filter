{
  "id": "bilibili",
  "name": "哔哩哔哩首页",
  "version": "0.7.1",
  "scriptVersion": "0.6.1",
  "supportsNotInterested": true,
  "scheduling": {
    "coverConcurrency": 48,
    "browserConcurrency": 8
  },
  "cover": {
    "hosts": [
      "i0.hdslb.com",
      "i1.hdslb.com",
      "i2.hdslb.com"
    ],
    "pathPattern": "^/bfs/(?:[a-zA-Z0-9_.-]+/)*[a-zA-Z0-9_-]+(?:\\.[a-zA-Z0-9_-]+)*$",
    "stripFrom": "@",
    "suffix": "@512w_80q.webp",
    "referer": "https://www.bilibili.com/"
  },
  "pagePolicy": {
    "corsReadTimeoutMs": 5000,
    "scope": ":is(.bili-feed4-layout,.recommended-container_floor-aside,.feed2)",
    "cards": ":is(.feed-card,.bili-feed-card,.bili-video-card)",
    "title": ".bili-video-card__info--tit, .bili-video-card__info--title, h3, .title, [role=\"heading\"], [data-title]",
    "native": ".bili-live-card, .bili-live-card__info--living, .bili-video-card__info--ad, .bili-video-card__info--creative-ad, .bili-ad-card, [data-card-type=\"live\" i], [data-card-type=\"ad\" i], [data-card-type=\"cm\" i], [data-goto=\"live\" i], [data-goto=\"cm\" i], [data-is-ad=\"1\"], [data-is-ad=\"true\"]",
    "cover": ".bili-video-card__cover img, img.bili-video-card__cover, a[href*=\"/video/\"] img, picture img, img[data-src*=\"/bfs/archive/\"], img[src*=\"/bfs/archive/\"]",
    "badge": ".badge, .tag, [class*=\"badge\"], [class$=\"--tag\"], .bili-video-card__stats--text, .bili-video-card__stats span, .bili-video-card__stats svg, .bili-video-card__image--link span, .bili-video-card__image--link [aria-label]",
    "skeleton": ".bili-video-card__skeleton",
    "author": ".bili-video-card__info--author, .up-name__text",
    "profile": "a[href^=\"//space.bilibili.com/\"], a[href^=\"https://space.bilibili.com/\"]",
    "videoLinks": "a[href*=\"/video/\"]",
    "imageLink": "a.bili-video-card__image--link"
  }
}
